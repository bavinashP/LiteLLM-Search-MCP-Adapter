# Copy to .env locally. Never commit .env or populated credentials.
LITELLM_BASE_URL=http://192.168.1.233:4000
LITELLM_API_KEY=REPLACE_WITH_DEDICATED_LITELLM_VIRTUAL_KEY
MCP_BEARER_TOKEN=REPLACE_WITH_A_LONG_RANDOM_ADAPTER_TOKEN

# Default-deny: list only Search Tool names explicitly approved for MCP exposure.
LITELLM_ALLOWED_SEARCH_TOOLS=spp_Parallel,openhands_tavily

# Host header allowlist must include the actual host:port sent by your reverse proxy.
ADAPTER_ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080,adapter:8080
# Keep empty unless browser-based MCP clients require specific trusted origins.
ADAPTER_ALLOWED_ORIGINS=

DISCOVERY_REFRESH_SECONDS=30
LITELLM_TIMEOUT_SECONDS=30
MAX_RESPONSE_BYTES=2000000
MCP_REQUESTS_PER_MINUTE=120
ADAPTER_HOST=0.0.0.0
ADAPTER_PORT=8080
LOG_LEVEL=INFO
